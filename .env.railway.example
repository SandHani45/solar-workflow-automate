# Railway variables for SolarFlow. Paste each block into the matching service's
# Variables tab (Raw Editor). ${{...}} are Railway reference variables, resolved
# by Railway at deploy time, so no password is ever stored in this repo.
# Rename `MongoDB` / `api` below if your services have different names.

# ─────────────── API service (config file: /apps/api/railway.json) ───────────────
MONGODB_URI=${{MongoDB.MONGO_URL}}
MONGODB_DB_NAME=solarflow
PORT=4000
NODE_ENV=production
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-96-hex-chars
JWT_REFRESH_SECRET=replace-with-a-different-96-hex-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Public URL of the web service (Networking → Generate domain on the web service)
APP_URL=https://your-web-service.up.railway.app
SUPER_ADMIN_EMAIL=you@yourcompany.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password
# Attach a volume to the API service mounted at /data/uploads
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=15
# Volumes are mounted as root; lets the container write uploads
RAILWAY_RUN_UID=0
# Seeds the demo org + demo users on first boot only (never overwrites). Set false for real use.
SEED_DEMO_ON_BOOT=true
LOG_LEVEL=info

# ─────────────── Web service (config file: /apps/web/railway.json) ───────────────
API_INTERNAL_URL=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}}
PORT=3000
