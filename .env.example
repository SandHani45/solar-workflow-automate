# ── API ──
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/solarflow
# Database name when the URI has none (e.g. Railway's MONGO_URL). Optional.
# MONGODB_DB_NAME=solarflow
# Load the demo organisation on boot if it doesn't exist yet (never overwrites).
SEED_DEMO_ON_BOOT=false
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-access
JWT_REFRESH_SECRET=replace-with-a-long-random-string-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Public URL of the web app (used for invite / reset links and CORS)
APP_URL=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
# Created on first boot if no super admin exists
SUPER_ADMIN_EMAIL=superadmin@solarflow.app
SUPER_ADMIN_PASSWORD=ChangeMe123!
LOG_LEVEL=info

# ── Web ──
API_INTERNAL_URL=http://localhost:4000

# ── Docker compose ──
MONGO_ROOT_USER=solar
MONGO_ROOT_PASSWORD=change-me
API_PORT=4000
WEB_PORT=3000
